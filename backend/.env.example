# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True

# Database: leave DB_ENGINE=sqlite for the no-Docker local setup.
DB_ENGINE=sqlite
DB_NAME=aifriends
DB_USER=aifriends
DB_PASSWORD=aifriends123
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis: leave blank to use Django's local in-memory cache.
# For docker-compose.yml use redis://127.0.0.1:16379/1
REDIS_URL=

# Optional AI services
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
